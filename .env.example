# ============================================================
# 校园知识库 & 学习资料智能问答复习助手
# 复制为 .env 后修改；.env 含密钥，禁止提交到 Git。
# docker compose 会自动读取本文件。
# ============================================================

# ---------- 基础 ----------
SERVER_PORT=8080
JWT_SECRET=please-change-to-a-random-string-at-least-32-characters
TOKEN_EXPIRE_HOURS=168
ALLOW_REGISTRATION=true

# 首次启动自动创建管理员（仅当库中还没有管理员时）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-123456
ADMIN_DISPLAY_NAME=系统管理员

# ---------- MySQL ----------
DB_PASSWORD=campus123456
MYSQL_ROOT_PASSWORD=root123456

# ---------- 向量库 ----------
# IntelliJ / 本机运行时用 localhost；docker compose 的 app 容器内会被覆盖为 http://chroma:8000
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=campus_kb
VECTOR_STORE=chroma

# ---------- 对话模型（OpenAI 兼容）----------
# 通义千问 / 阿里云百炼：
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# DeepSeek（仅对话，embedding 仍需百炼或其他兼容服务）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# 本地 Ollama（同时设置 embedding；EMBEDDING_SEND_DIMENSIONS=false）：
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ---------- 向量模型（OpenAI 兼容 /embeddings）----------
# 百炼 text-embedding-v3：1024 维
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=10

# ---------- RAG 参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=6
MIN_SCORE=0.30
MAX_CONTEXT_CHARS=7000

# ---------- 上传 ----------
UPLOAD_DIR=./uploads